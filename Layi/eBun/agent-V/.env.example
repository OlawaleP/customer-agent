# --- Model ---
# Leave both unset to run against MockLLM (zero-infra, deterministic, used
# by the eval harness and for local testing without any API key).
# LLM_BASE_URL=http://localhost:8000/v1      # vLLM
# LLM_BASE_URL=http://localhost:11434/v1     # Ollama
# LLM_BASE_URL=https://openrouter.ai/api/v1  # hosted open-weight models
# LLM_API_KEY=your-key-here
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Ticketing (Chatwoot) ---
# Leave unset to run in mock mode (prints actions instead of calling a real API).
# CHATWOOT_BASE_URL=https://your-chatwoot-host
# CHATWOOT_API_TOKEN=your-agent-bot-token
# CHATWOOT_ACCOUNT_ID=1
#
# Required once you point a real Chatwoot instance's webhook at
# POST /webhooks/chatwoot -- get this from Settings -> Integrations ->
# Webhooks -> (your webhook) -> shown once at creation, viewable again on
# the edit form. Without this set, signature verification is skipped
# entirely, which is fine for local testing but not for a public URL.
# CHATWOOT_WEBHOOK_SECRET=

# --- Knowledge base ---
# Leave unset to use the small in-memory mock doc set.
# QDRANT_URL=http://localhost:6333

# --- Checkpointing (production) ---
# DATABASE_URL=postgresql://agent:agent_dev_password@localhost:5432/giftcard_agent

# --- Image moderation (platform uploads, NOT the ticket pipeline) ---
# Leave unset to run in mock mode. A real OpenAI platform key -- this is
# separate from LLM_API_KEY above even if that's also pointed at an
# OpenAI-shaped endpoint (Groq only mimics the API shape; it doesn't proxy
# OpenAI's own moderation endpoint). The endpoint itself is free to call.
# OPENAI_API_KEY=your-openai-platform-key
#
# The id of ONE pre-existing Chatwoot conversation your moderator has
# already opened with your WhatsApp inbox -- every flagged image is posted
# as a new message into this same conversation. Find it in the Chatwoot
# dashboard URL when viewing that conversation.
# CHATWOOT_MODERATION_CONVERSATION_ID=
